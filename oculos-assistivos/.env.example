# Copie este arquivo para .env e preencha os valores no servidor.
# Senha forte obrigatória para autorizar gravação de chaves pelo formulário do app.
SETUP_PASSWORD=troque-por-uma-senha-forte-com-mais-de-12-caracteres
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WAPI: os nomes abaixo ficam no servidor. A integração de envio depende
# da URL e do formato de autenticação documentados pelo seu provedor WAPI.
WAPI_API_URL=
WAPI_INSTANCE_ID=
WAPI_TOKEN=

# Alertas automáticos atualmente compatíveis com Twilio e SendGrid.
CAREGIVER_PHONE=
CAREGIVER_EMAIL=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
SENDGRID_KEY=
MAIL_FROM=